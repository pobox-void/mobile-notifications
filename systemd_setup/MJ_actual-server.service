# NOTE: Replace $USER with your system username and $HOME with your full home path (e.g., /home/username)
# Systemd requires absolute paths for these directives.
[Unit]
Description=Actual Budget Server
After=network.target

[Service]
Type=simple
User=$USER
WorkingDirectory=$HOME/source/actual
ExecStart=$HOME/.nvm/versions/node/v20.11.0/bin/node $HOME/source/actual/.yarn/releases/yarn-4.3.1.cjs start:server
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PATH=$HOME/.nvm/versions/node/v20.11.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StandardOutput=append:$HOME/source/mobile-notifications/logs/actual-server.log
StandardError=append:$HOME/source/mobile-notifications/logs/actual-server.log

[Install]
WantedBy=multi-user.target
