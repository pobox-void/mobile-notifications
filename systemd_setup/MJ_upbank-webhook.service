# NOTE: Replace $USER with your system username and $HOME with your full home path (e.g., /home/username)
# Systemd requires absolute paths for these directives.
[Unit]
Description=Up Bank Webhook Server
After=network.target

[Service]
Type=simple
User=$USER
WorkingDirectory=$HOME/source/mobile-notifications
ExecStart=$HOME/.nvm/versions/node/v20.11.0/bin/node dist/server.js
Restart=always
RestartSec=10
StandardOutput=append:$HOME/source/mobile-notifications/logs/webhook.log
StandardError=append:$HOME/source/mobile-notifications/logs/webhook.log

# Environment
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
